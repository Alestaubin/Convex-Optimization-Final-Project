%Will compute prox_g for both l1 and l2
% Note: this function assumes the parameters are correct.
function prox_output = prox_g(problem, b, i, y, t)
    arguments
        problem char
        b (:,:) double
        i struct
        y (:,:,3) double
        t double
    end

    %computing the prox depending on desired norm (l1 or l2)
    
    %{
    switch problem
        case 'l1'
            gamma_norm = i.gammal1;
            prox_norm = DeblurStuff.utilities.prox.l1prox(y(:,:,1), t, b);
        case 'l2'
            gamma_norm = i.gammal2;
            prox_norm = DeblurStuff.utilities.prox.l2prox(y(:,:,1), t, b);
    end
    %}

    [prox_norm, gamma_norm] = DeblurStuff.utilities.problemSelect(problem, b, t, i);
    
    %Computing 

    %coomputing iso prox
    prox_iso = DeblurStuff.utilities.prox.isoprox(y(:,:,2:3),t*gamma_norm);

    %grouping it together
    prox_output = cat(3, prox_norm, prox_iso);
end
