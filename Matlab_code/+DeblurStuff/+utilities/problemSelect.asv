
function p = problemSelect( problem, b, i )
    switch lower(problem)
        case 'l1'
            p =@(y) DeblurStuff.utilities.prox.l1prox( y, b, i.gammal1, i. );
        case 'l2'
            p =@(y) DeblurStuff.utilities.prox.l2prox( y, b, i.gammal2 );
        otherwise
            error('Unknown problem.');
    end
end